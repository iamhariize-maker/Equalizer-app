<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Headphone measurements and target curves (AutoEq) are fetched on demand. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Optional: the Svaramanas bubble floating over players. Everything also works without it. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Granted manually over ADB for enhanced session detection (Engine A). -->
    <uses-permission android:name="android.permission.DUMP"
        tools:ignore="ProtectedPermissions" />

    <!-- Package visibility (Android 11+): Svan must resolve the uid/name of the
         apps whose audio it routes. Music apps have a launcher activity or a
         media browser service; this avoids the Play-restricted QUERY_ALL_PACKAGES. -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
    </queries>

    <!-- allowAudioPlaybackCapture=false: our processed output must never be
         captured back into Engine B (feedback loop). -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Svan"
        android:allowAudioPlaybackCapture="false"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Runtime receiver in SystemEqService also receives general player
             broadcasts, which Android 8+ drops for a manifest-only receiver. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <service
            android:name=".SystemEqService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Svaramanas: dialog over any app, floating bubble, Quick Settings tile. -->
        <activity
            android:name=".svaramanas.SvaramanasActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="app.svan.svaramanas"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Svan.Overlay" />

        <service
            android:name=".svaramanas.SvaramanasBubbleService"
            android:exported="false" />

        <service
            android:name=".svaramanas.SvaramanasTileService"
            android:exported="true"
            android:icon="@drawable/ic_svaramanas"
            android:label="Svaramanas"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".CaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>
</manifest>

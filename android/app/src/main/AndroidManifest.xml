<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Headphone measurements and target curves (AutoEq) are fetched on demand. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Optional: the Svaramanas bubble floating over players. Everything also works without it. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Compatibility with existing/manual grants; normal setup reads reports as shell. -->
    <uses-permission android:name="android.permission.DUMP"
        tools:ignore="ProtectedPermissions" />

    <!-- Package visibility (Android 11+): Svan must resolve the uid/name of the
         apps whose audio it routes. Music apps have a launcher activity or a
         media browser service; this avoids the Play-restricted QUERY_ALL_PACKAGES. -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <!-- Explicit visibility for common streaming and offline players. The
             launcher/media-browser queries below still cover other players;
             do not request broad QUERY_ALL_PACKAGES inventory access. -->
        <package android:name="com.google.android.apps.youtube.music" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.spotify.music" />
        <package android:name="com.amazon.mp3" />
        <package android:name="deezer.android.app" />
        <package android:name="com.aspiro.tidal" />
        <package android:name="com.qobuz.music" />
        <package android:name="com.apple.android.music" />
        <package android:name="com.soundcloud.android" />
        <package android:name="com.pandora.android" />
        <package android:name="com.maxmpz.audioplayer" />
        <package android:name="com.onkyo.jp.musicplayer" />
        <package android:name="com.neutroncode.mp" />
        <package android:name="com.hiby.music" />
        <package android:name="com.fiio.music" />
        <package android:name="com.extreamsd.usbaudioplayerpro" />
        <package android:name="org.videolan.vlc" />
        <package android:name="com.foobar2000.foobar2000" />
        <package android:name="com.aimp.player" />
        <package android:name="in.krosbits.musicolet" />
        <package android:name="com.rhmsoft.pulsar" />
        <package android:name="com.plexapp.android" />
        <package android:name="com.neutroncode.mpeval" />
        <package android:name="com.spotify.lite" />
        <package android:name="com.sec.android.app.music" />
        <package android:name="com.miui.player" />
        <package android:name="com.google.android.music" />
        <package android:name="com.jio.media.jiobeats" />
        <package android:name="com.gaana" />
        <package android:name="com.bsbportal.music" />
        <package android:name="com.audiomack" />
        <package android:name="com.anghami" />
        <package android:name="com.afmobi.boomplayer" />
        <package android:name="com.transsion.music" />
        <package android:name="code.name.monkey.retromusic" />
        <package android:name="com.simplemobiletools.musicplayer" />
        <package android:name="org.schabi.newpipe" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
    </queries>

    <!-- allowAudioPlaybackCapture=false: our processed output must never be
         captured back into Engine B (feedback loop). -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Svan"
        android:allowAudioPlaybackCapture="false"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Runtime receiver in SystemEqService also receives general player
             broadcasts, which Android 8+ drops for a manifest-only receiver. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <service
            android:name=".SystemEqService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Optional player identity/playback fallback; no notification contents are read. -->
        <service
            android:name=".PlayerRecognitionService"
            android:label="Svan player recognition (optional)"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Svaramanas: dialog over any app, floating bubble, Quick Settings tile. -->
        <activity
            android:name=".svaramanas.SvaramanasActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="app.svan.svaramanas"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Svan.Overlay" />

        <service
            android:name=".svaramanas.SvaramanasBubbleService"
            android:exported="false" />

        <service
            android:name=".svaramanas.SvaramanasTileService"
            android:exported="true"
            android:icon="@drawable/ic_svaramanas"
            android:label="Svaramanas"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".CaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>
</manifest>
